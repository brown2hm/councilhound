# Local dev for the Fairfax County stack: copy to .env (or export) before
# running the CLI. Separate DATA_DIR keeps the embedded Postgres, raw media
# and captions apart from the City's.
JURISDICTION=fairfax_county_va
DATA_DIR=data/fairfax_county_va
# The City's .env sets these as per-deployment overrides; blank them so the
# County config's Granicus host and views apply (an empty value defers to
# the config, and python-dotenv never overrides a variable already set).
GRANICUS_BASE_URL=
GRANICUS_VIEW_IDS=
ANTHROPIC_API_KEY=
