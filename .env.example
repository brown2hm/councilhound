# Copy to .env and fill in. docker-compose reads this for all services.
POSTGRES_USER=fairfax
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fairfax_kb
# Docker/cloud only — leave unset for local dev (embedded Postgres)
# DATABASE_URL=postgresql://fairfax:changeme@postgres:5432/fairfax_kb

ANTHROPIC_API_KEY=

# Which jurisdiction this stack serves: ingestion/jurisdictions/<slug>.yaml
# supplies the Granicus host/views, bodies, branding and map defaults.
JURISDICTION=fairfax_city_va
# Per-deployment overrides of the jurisdiction config (normally unset)
# GRANICUS_BASE_URL=https://fairfax.granicus.com
# GRANICUS_VIEW_IDS=13
RAW_DATA_DIR=/data/raw
